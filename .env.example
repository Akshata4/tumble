# --- W&B Inference (LLM reasoning) ---
WANDB_API_KEY=
WANDB_PROJECT=your-team/your-project

# --- E2B (sandboxed code execution) ---
E2B_API_KEY=

# Optional: OpenRouter fallback provider
# LLM_PROVIDER=openrouter
# OPENROUTER_API_KEY=

# --- Server-only: global daily safety budget (server.py) ---
# Placeholder defaults, not derived from a specific cost target -- see DESIGN.md.
# DAILY_SANDBOX_SECONDS_BUDGET=3600
# DAILY_LLM_TOKEN_BUDGET=2000000

# --- Server-only: allowed frontend origin(s), comma-separated ---
# Defaults to "*" (open) since there's no auth yet either. Tighten this
# once the frontend has a real deployed origin.
# CORS_ORIGINS=http://localhost:5173

# --- Server-only: Cloudflare Turnstile bot-check on POST /start ---
# Unset = disabled (nothing is blocked). Get a real key pair free at
# https://dash.cloudflare.com -> Turnstile, and set the matching site key
# as VITE_TURNSTILE_SITE_KEY in frontend/.env. For local testing without a
# Cloudflare account, Cloudflare publishes an always-passes test pair:
# secret 1x0000000000000000000000000000000AA with sitekey 1x00000000000000000000AA
# (see https://developers.cloudflare.com/turnstile/troubleshooting/testing/).
# TURNSTILE_SECRET_KEY=
