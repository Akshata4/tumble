# Base URL of the running Tumble backend (server.py).
VITE_API_BASE=http://localhost:8000

# Cloudflare Turnstile site key. Unset = no widget rendered, no bot-check
# on Start run. Must match the backend's TURNSTILE_SECRET_KEY (see
# ../.env.example) -- both are set, or neither is.
# VITE_TURNSTILE_SITE_KEY=
